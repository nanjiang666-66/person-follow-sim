<?xml version="1.0"?>
<sdf version="1.6">
  <world name="person_follow_empty">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters></solver></ode>
    </physics>
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.8 0.9 1 1</background></scene>
  </world>
</sdf>
