<?xml version="1.0"?>
<!-- Geometry adapted from the user's robot_nav_course differential-drive model. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="follow_bot">
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_y" value="0.195"/>
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
      iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/>
  </xacro:macro>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.12"/>
  </joint>
  <link name="base_link">
    <visual><geometry><box size="0.50 0.34 0.12"/></geometry>
      <material name="blue"><color rgba="0.1 0.35 0.8 1"/></material></visual>
    <collision><geometry><box size="0.50 0.34 0.12"/></geometry></collision>
    <inertial><mass value="8.0"/><xacro:box_inertia mass="8.0" x="0.5" y="0.34" z="0.12"/></inertial>
  </link>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual><origin rpy="1.5707963268 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.03 0.03 0.03 1"/></material></visual>
      <collision><origin rpy="1.5707963268 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="0.8"/>
        <inertia ixx="${0.8*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}" ixy="0" ixz="0"
          iyy="${0.8*wheel_radius*wheel_radius/2}" iyz="0"
          izz="${0.8*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} -0.02"/><axis xyz="0 1 0"/><dynamics damping="0.05" friction="0"/>
    </joint>
    <gazebo reference="${side}_wheel_link"><material>Gazebo/Black</material><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_y}"/><xacro:wheel side="right" y="${-wheel_y}"/>
  <xacro:macro name="support" params="name x">
    <link name="${name}">
      <visual><geometry><sphere radius="0.045"/></geometry></visual>
      <collision><geometry><sphere radius="0.045"/></geometry></collision>
      <inertial><mass value="0.2"/><inertia ixx="0.000162" ixy="0" ixz="0" iyy="0.000162" iyz="0" izz="0.000162"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.075"/>
    </joint>
    <gazebo reference="${name}"><material>Gazebo/Grey</material><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  </xacro:macro>
  <xacro:support name="front_support" x="0.18"/><xacro:support name="rear_support" x="-0.18"/>
  <link name="camera_mast">
    <visual><geometry><box size="0.015 0.015 0.8"/></geometry></visual>
    <collision><geometry><box size="0.015 0.015 0.8"/></geometry></collision>
    <inertial><mass value="0.1"/><xacro:box_inertia mass="0.1" x="0.015" y="0.015" z="0.8"/></inertial>
  </link>
  <joint name="camera_mast_joint" type="fixed">
    <parent link="base_link"/><child link="camera_mast"/><origin xyz="0.20 0 0.48"/>
  </joint>
  <link name="camera_link">
    <visual><geometry><box size="0.04 0.09 0.03"/></geometry>
      <material name="camera_gray"><color rgba="0.7 0.7 0.7 1"/></material></visual>
    <collision><geometry><box size="0.04 0.09 0.03"/></geometry></collision>
    <inertial><mass value="0.08"/><xacro:box_inertia mass="0.08" x="0.04" y="0.09" z="0.03"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.25 0 0.88"/>
  </joint>
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_color_optical_frame"/>
    <origin rpy="-1.5707963268 0 -1.5707963268"/>
  </joint>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo>
    <plugin name="follow_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation><wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque><max_wheel_acceleration>1.5</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic><odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>
</robot>
